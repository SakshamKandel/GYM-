{
  "expo": {
    "name": "The GM Method",
    "slug": "gym-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gymtracker",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#131416",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.gmmethod.gymtracker",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.gmmethod.gymtracker",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#131416",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 100
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#FF3B30"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "The GM Method uses the camera to scan food barcodes and take progress photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The GM Method needs photo library access so you can add a profile photo, save private progress photos, and attach payment receipts.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "The GM Method uses Face ID to unlock the app when app lock is turned on."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "The GM Method counts your daily steps to show activity and calories burned."
        }
      ],
      "expo-health-connect"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "688fd373-aa41-4662-b5aa-eae6ec6e0dda"
      }
    },
    "owner": "kurlybrains"
  }
}
