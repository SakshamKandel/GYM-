# Copy to .env and fill in. NEVER commit .env.
# Every variable below says what stops working while it is missing.
# The same table, with the same wording, lives in docs/DEPLOY.md §1.

# --- Core ------------------------------------------------------------------
# Neon Postgres connection string (Neon console > Connect). Unset: nothing runs,
# every API route fails.
DATABASE_URL=

# Public origin of the website. Unset: canonical links, sitemap.xml and
# robots.txt fall back to the old preview domain and point search engines there.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# --- Mobile app (compiled into the build, so never put a secret here) -------
# API base URL the app calls (apps/web). Unset: the app talks to
# http://localhost:3000, so a store build reaches nothing at all.
EXPO_PUBLIC_API_URL=

# Optional second food source: free USDA FoodData Central key
# (https://fdc.nal.usda.gov/api-key-signup). Unset: food search still works
# through Open Food Facts, with fewer US branded results.
EXPO_PUBLIC_USDA_API_KEY=

# Google Sign-In client ids (Google Cloud console > Credentials). Unset: the
# Google button stays hidden and only email sign-in is offered.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# --- Sign-in (server side) -------------------------------------------------
# Accepted Google ID-token audiences. GOOGLE_CLIENT_ID is the same WEB client
# embedded in the app; GOOGLE_CLIENT_IDS may list the web, Android and iOS ids
# comma-separated. Both unset: the server rejects every Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# Accepted Apple ID-token audiences (Services ID / bundle id), same
# single-vs-comma-separated pair. Both unset: Apple sign-in rejects every token.
APPLE_CLIENT_ID=
APPLE_CLIENT_IDS=

# --- Email (password reset) ------------------------------------------------
# Resend API key (https://resend.com > API Keys). Unset: POST
# /api/auth/forgot-password sends nothing, mints nothing and reports
# 'not_configured', so the app tells members reset by email is unavailable and a
# password can only be reset by an admin from the member credentials tool.
RESEND_API_KEY=
# Verified sender, e.g. "The GM Method <no-reply@yourdomain.com>". The domain
# must be verified in Resend or it refuses the message. Unset: exactly as above.
# Both values are required; either one missing means no email is ever sent.
EMAIL_FROM=

# --- Push notifications ----------------------------------------------------
# Base64 of the Firebase service-account JSON (Firebase console > Project
# settings > Service accounts). Unset: no push is ever delivered. Inbox rows are
# still written, so reminders, coach replies, order updates and broadcasts only
# appear once the member opens the app.
FIREBASE_SERVICE_ACCOUNT_B64=

# --- Billing (store webhook) -----------------------------------------------
# 'disabled' (default, no paid activation) | 'preview' (non-production only:
# tiers are a free selection) | 'live' (paid tiers only via RevenueCat).
# Unset: nobody can buy a plan. 'live' needs BOTH variables below; with either
# one missing the server reports 'disabled' instead of pretending to sell.
BILLING_MODE=
# Required for BILLING_MODE=live: the exact Authorization header value the
# RevenueCat webhook must send. Unset: billing falls back to 'disabled', so
# purchases in the stores never grant a tier. The boot log names it.
REVENUECAT_WEBHOOK_AUTH=
# Also required for BILLING_MODE=live: the signing secret of that same
# RevenueCat webhook. /api/subscription/revenuecat verifies the signature on
# every event and rejects with 401 without it, so leaving this blank while
# selling would take real money and grant nothing. Unset: billing falls back to
# 'disabled' exactly as above, and the boot log names it.
REVENUECAT_WEBHOOK_SIGNATURE_SECRET=
# RevenueCat PUBLIC app-specific API keys (RevenueCat > Project settings > API
# keys), one per store. Compiled into the app and safe to ship: they can only
# read offerings and start a purchase the store itself confirms. Unset: the
# purchase sheet and the Restore purchases row never appear on that platform,
# and the paywall falls back to the manual receipt rail. For a store build set
# these as EAS variables or in the eas.json profile env, not only here.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- Media (images + video) ------------------------------------------------
# Cloudinary account name. The three CLOUDINARY_* below are needed together.
# Any of them missing: avatars, receipts and progress photos cannot be uploaded
# at all, and video too unless VIDEO_PROVIDER=cf_stream is set up instead.
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key (Cloudinary console > Settings > Access Keys).
CLOUDINARY_API_KEY=
# Cloudinary API secret, signs uploads. Rotate it if it ever leaves the vault.
CLOUDINARY_API_SECRET=
# Signs authenticated image links (private CDN add-on). Unset: payment receipts
# and progress photos still upload, but every attempt to VIEW one answers 503,
# so an admin cannot see the receipt they are approving money against. The
# admin console and the startup log both report photos as turned off.
CLOUDINARY_URL_SIGNING_KEY=
# Optional: 'cloudinary' (default when the CLOUDINARY_* keys are set) or
# 'cf_stream'. Unset: Cloudinary is used when its keys exist.
VIDEO_PROVIDER=
# The next four are only for VIDEO_PROVIDER=cf_stream and are needed together.
# Any of them missing: coaches cannot publish or play plan videos.
CF_STREAM_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_KEY_ID=
CF_STREAM_JWK=

# --- AI coach tip ----------------------------------------------------------
# Groq API key (https://console.groq.com/keys), the ONLY AI surface in the
# product: the short coach tip on Home and Progress. Server side only, never in
# the app bundle. Unset: /api/ai/tip answers 'not_configured' and both cards
# fall back to their quiet empty state. Nothing else breaks.
GROQ_API_KEY=

# --- Scheduled jobs --------------------------------------------------------
# Shared secret Vercel Cron sends as "Authorization: Bearer <value>". Unset:
# every /api/cron/* route fails closed with 500 and no scheduled job runs.
CRON_SECRET=
# Master switch for the scheduled notification scans. Must be exactly 'true'.
# Anything else: the tick returns {skipped:"disabled"}, so renewal notices,
# payment reminders and come-back nudges are never sent.
NOTIFICATIONS_CRON_ENABLED=

# --- Rate-limit store (optional, recommended in production) ----------------
# Redis REST credentials for the shared limiter on sign-in, registration,
# password reset and staff re-auth. Unset: those limits count per instance, so
# the real ceiling is limit x number of warm instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel's KV integration injects these two names instead. Either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Operations switches ---------------------------------------------------
# Email of the coach Elite members are auto-assigned to. Unset: the oldest coach
# account is used instead.
COACH_GREECE_EMAIL=
# Per-account notification preferences and quiet hours. Default on. Set to
# 'false' ONLY to debug a suspected preferences bug: every member then gets
# every push regardless of what they turned off.
NOTIF_PREFS_ENFORCED=
# Meal checkout price-change guard. Set to 'true' to reject an order whose total
# moved since the cart was priced. Unset: the order goes through at the new
# price without asking.
PRICE_CHANGE_GUARD_ENABLED=
# Partner ledger cutover marker, for observability only. It must never gate
# money math. Unset: no effect on any balance.
PARTNER_LEDGER_ENABLED=
# Demo coach seed guard (packages/db seed:demo-coach). Must be exactly 'yes' or
# the seed refuses to run, and it never runs under NODE_ENV=production.
SEED_DEMO=
